# PayPal Sandbox Configuration (https://developer.paypal.com/dashboard/)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
# Optional: Webhook ID from PayPal Developer Dashboard for signature verification
PAYPAL_WEBHOOK_ID=

# Multi-Provider AI Router (tries in priority order; fails over automatically on 429/quota/5xx)
AI_PROVIDER_ORDER=anthropic,openai,gemini,openrouter

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview,gemini-flash-latest,gemini-flash-lite-latest

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Optional persistence path override
ESCROW_DB_PATH=./data/escrow-db.json

